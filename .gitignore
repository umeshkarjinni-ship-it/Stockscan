# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# Runtime output (regenerated on every run — keep folders, ignore contents)
signals/*
!signals/.gitkeep
# Exception: the paper trade tracker must persist across runs to be useful
!signals/paper_trades.csv
!signals/paper_trade_summary.txt
# Exception: committed by the daily workflow so the dashboard can show
# conflicting BUY/SELL signals. Without this, `git add` fails on an
# ignored path and the whole commit step exits 1.
!signals/conflicting_signals.csv
reports/*
!reports/.gitkeep
cache/*
!cache/.gitkeep
logs/*
!logs/.gitkeep

# Raw NSE downloads used only as a manual-fallback cache for build_universe.py
equity_l.csv
nifty100.csv
niftymidcap150.csv
niftysmallcap250.csv
EQUITY_L.csv
ind_nifty100list.csv
ind_niftymidcap150list.csv
ind_niftysmallcap250list.csv

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# docs/index.html is committed by the workflow (dashboard) — keep tracked
