//@version=5
indicator("Weekly/Monthly Buy Signal — VStop + ATR + EMA + RSI + Volume", overlay=true, max_labels_count=500)

// =========================================================================
// HOW TO USE
// - Best applied DIRECTLY on the Weekly or Monthly chart of an NSE/BSE stock.
// - "Buy" label = fresh uptrend flip (Volatility Stop) + EMA trend alignment
//   + RSI momentum + above-average volume + ADX trend-strength + NIFTY 50
//   market regime alignment + (on Weekly charts) Monthly trend confluence.
// - "Sell/Exit" label = Volatility Stop flips to downtrend.
// - This is a decision-support tool, NOT a guarantee. Always combine with
//   fundamentals, position sizing, and stop-loss discipline. Backtest first.
// =========================================================================

// ---------------- Inputs ----------------
grp1 = "Volatility Stop (ATR Trailing Stop)"
atrLen  = input.int(14, "ATR Length", group = grp1)
atrMult = input.float(3.0, "ATR Multiplier", step = 0.1, group = grp1,
     tooltip = "Higher = fewer, more reliable flips. Lower = more sensitive/more signals.")

grp2 = "Trend Filter (EMA)"
emaFastLen = input.int(20, "Fast EMA", group = grp2)
emaMidLen  = input.int(50, "Mid EMA", group = grp2)
emaSlowLen = input.int(100, "Slow EMA", group = grp2)
requireEmaStack = input.bool(true, "Require EMA20 > EMA50 > EMA100 (strict uptrend)", group = grp2)

grp3 = "Momentum Filter (RSI)"
rsiLen        = input.int(14, "RSI Length", group = grp3)
rsiBuyLevel   = input.int(50, "RSI must be above", group = grp3)
rsiOverbought = input.int(78, "Avoid buy if RSI above (overbought)", group = grp3)

grp4 = "Volume Confirmation"
volMaLen   = input.int(20, "Volume MA Length", group = grp4)
volMultReq = input.float(1.2, "Buy candle volume must exceed MA x", step = 0.1, group = grp4)

grp7 = "Trend Strength (ADX) — filters choppy/sideways conditions"
adxLen       = input.int(14, "ADX Length", group = grp7)
adxThreshold = input.int(20, "Require ADX above this to accept a BUY", group = grp7)

grp8 = "Market Regime & Multi-Timeframe Confluence"
useRegimeFilter = input.bool(true, "Require NIFTY 50 uptrend on same timeframe", group = grp8)
regimeSymbol    = input.symbol("NSE:NIFTY", "Index symbol for regime check", group = grp8)
requireMonthlyConfluence = input.bool(true, "On Weekly chart, also require Monthly uptrend", group = grp8)

grp5 = "Display"
showBackground = input.bool(true, "Shade background by trend", group = grp5)
showTable      = input.bool(true, "Show status table", group = grp5)

// ---------------- Volatility Stop (ATR trailing stop) ----------------
src = close
atrVal = atrMult * ta.atr(atrLen)

var float stop    = na
var bool  uptrend = true
var float extreme = na

extreme := na(extreme) ? src : (uptrend ? math.max(extreme, src) : math.min(extreme, src))
newStop  = uptrend ? extreme - atrVal : extreme + atrVal

if na(stop)
    stop := newStop
else
    stop := uptrend ? math.max(stop, newStop) : math.min(stop, newStop)

flip = uptrend ? src < stop : src > stop
if flip
    uptrend := not uptrend
    extreme := src
    stop    := uptrend ? src - atrVal : src + atrVal

flipToUp   = flip and uptrend
flipToDown = flip and not uptrend

// ---------------- EMA Trend Filter ----------------
emaFast = ta.ema(src, emaFastLen)
emaMid  = ta.ema(src, emaMidLen)
emaSlow = ta.ema(src, emaSlowLen)

emaTrendOk = requireEmaStack ? (emaFast > emaMid and emaMid > emaSlow) : (src > emaMid)

// ---------------- RSI Momentum Filter ----------------
rsiVal = ta.rsi(src, rsiLen)
rsiOk  = rsiVal > rsiBuyLevel and rsiVal < rsiOverbought

// ---------------- Volume Confirmation ----------------
volMa = ta.sma(volume, volMaLen)
volOk = volume > volMa * volMultReq

// ---------------- Trend Strength Filter (ADX) ----------------
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
adxOk = adxVal > adxThreshold

// ---------------- Market Regime Filter (NIFTY 50 on same timeframe) ----------------
f_regimeUptrend() =>
    rsrc = close
    ratrVal = atrMult * ta.atr(atrLen)
    var float rstop    = na
    var bool  ruptrend = true
    var float rextreme = na
    rextreme := na(rextreme) ? rsrc : (ruptrend ? math.max(rextreme, rsrc) : math.min(rextreme, rsrc))
    rnewStop  = ruptrend ? rextreme - ratrVal : rextreme + ratrVal
    if na(rstop)
        rstop := rnewStop
    else
        rstop := ruptrend ? math.max(rstop, rnewStop) : math.min(rstop, rnewStop)
    rflip = ruptrend ? rsrc < rstop : rsrc > rstop
    if rflip
        ruptrend := not ruptrend
        rextreme := rsrc
        rstop    := ruptrend ? rsrc - ratrVal : rsrc + ratrVal
    ruptrend

niftyUptrend = request.security(regimeSymbol, timeframe.period, f_regimeUptrend(), lookahead = barmerge.lookahead_off)
regimeOk = not useRegimeFilter or niftyUptrend

// ---------------- Multi-Timeframe Confluence ----------------
// If this chart is Weekly, also require this stock's own Monthly trend to
// be UP — a weekly flip against the bigger monthly trend is lower quality.
monthlyUptrendForConfluence = request.security(syminfo.tickerid, "M", f_regimeUptrend(), lookahead = barmerge.lookahead_off)
confluenceOk = (requireMonthlyConfluence and timeframe.isweekly) ? monthlyUptrendForConfluence : true

// ---------------- Composite Buy / Sell ----------------
buySignal  = flipToUp and emaTrendOk and rsiOk and volOk and adxOk and regimeOk and confluenceOk
sellSignal = flipToDown

// ---------------- Plots ----------------
plot(stop, "Volatility Stop", color = uptrend ? color.new(color.green, 0) : color.new(color.red, 0), linewidth = 2, style = plot.style_linebr)

plot(emaFast, "EMA Fast", color = color.new(color.aqua, 40))
plot(emaMid,  "EMA Mid",  color = color.new(color.orange, 40))
plot(emaSlow, "EMA Slow", color = color.new(color.purple, 40))

plotshape(buySignal, title = "Buy", style = shape.labelup, location = location.belowbar,
     color = color.new(color.green, 0), text = "BUY", textcolor = color.white, size = size.small)

plotshape(sellSignal, title = "Sell/Exit", style = shape.labeldown, location = location.abovebar,
     color = color.new(color.red, 0), text = "EXIT", textcolor = color.white, size = size.small)

bgcolor(showBackground ? (uptrend ? color.new(color.green, 92) : color.new(color.red, 92)) : na)

// ---------------- Status Table ----------------
if showTable
    var table t = table.new(position.top_right, 2, 8, border_width = 1)
    table.cell(t, 0, 0, "Trend",     bgcolor = color.gray, text_color = color.white)
    table.cell(t, 1, 0, uptrend ? "UP" : "DOWN", bgcolor = uptrend ? color.green : color.red, text_color = color.white)
    table.cell(t, 0, 1, "RSI")
    table.cell(t, 1, 1, str.tostring(math.round(rsiVal, 1)))
    table.cell(t, 0, 2, "EMA Stack OK")
    table.cell(t, 1, 2, emaTrendOk ? "Yes" : "No")
    table.cell(t, 0, 3, "Volume OK")
    table.cell(t, 1, 3, volOk ? "Yes" : "No")
    table.cell(t, 0, 4, "ADX")
    table.cell(t, 1, 4, str.tostring(math.round(adxVal, 1)) + (adxOk ? " OK" : " weak"))
    table.cell(t, 0, 5, "Market Regime")
    table.cell(t, 1, 5, regimeOk ? "OK" : "Against")
    table.cell(t, 0, 6, "VStop")
    table.cell(t, 1, 6, str.tostring(math.round(stop, 2)))
    table.cell(t, 0, 7, "Signal")
    table.cell(t, 1, 7, buySignal ? "BUY" : sellSignal ? "EXIT" : "-")

// ---------------- Alerts ----------------
alertcondition(buySignal,  title = "Buy Signal",  message = "{{ticker}}: Weekly/Monthly BUY signal (VStop flip + trend + RSI + volume confirmed)")
alertcondition(sellSignal, title = "Sell/Exit Signal", message = "{{ticker}}: Volatility Stop flipped to downtrend — consider exit/trailing stop")
